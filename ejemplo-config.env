# ejemplo-config.js
# ⚠️ IMPORTANTE: NO subir este archivo a GitHub si contiene datos reales
# Únicamente usar como referencia para configurar variables de entorno

# Para uso local:
# 1. Copia este archivo a "config.js" (no está en .gitignore por defecto)
# 2. Reemplaza los valores con los reales
# 3. Importa en tu index.html: <script src="config.js"></script>

# Configuración de WhatsApp
# Formato: código de país + número (ej: 549 222 1503 994 → 5492215039940)
VITE_WHATSAPP_NUMBER=5492215039940

# Configuración de Google Sheet
# URL CSV pública. Si es privada, debes autenticarse via backend
VITE_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vSqA-VpNXutnP9MjboYk4O95v-NXEik7EmOs_bl7ooTpk4F1V6Vdid9KEvtqv8ikzdqaZ5ImdM1Hyh0/pub?gid=0&single=true&output=csv

# Dominios permitidos para imágenes
# Agregar más separados por coma
VITE_ALLOWED_IMAGE_DOMAINS=raw.githubusercontent.com,imgur.com,cdn.example.com

# Modo desarrollo
VITE_DEV_MODE=false

# Endpoint del backend (si lo usas)
VITE_API_BASE_URL=https://api.tudominio.com
